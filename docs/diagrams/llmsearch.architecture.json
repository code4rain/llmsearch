  "cards": [
    {
      "dot": "cyan",
      "title": "Chat request path",
      "items": [
        "local_origin_only → _require_db → _validate_filters; history rebuilt from chats.db; Claude may call the search tool ≤3 more rounds",
        "Retrieval: vec 30 + FTS5 30 → RRF k=60 → 3 chunks/doc; recency ≤+30%, Archives/ ×0.5; SSE text · sources · saved · done"
      ]
    },
    {
      "dot": "violet",
      "title": "Sync & cost control",
      "items": [
        "scheduler_loop every 30 min → run_sync per source under sync_lock; gates: DB · Windows-only · daily budget; delete after 3 misses + safe sweep",
        "CountingEmbedder / CountingSummarizer → usage.json daily counters; cap blocks indexing only"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "127.0.0.1 bind + TrustedHost + local_origin_only CSRF guard (fail-closed); /api/open only opens registered targets; secrets only via .env",
        "All integrations are Protocol + Fake (LLM, embeddings, summarizer, Outlook, Atlassian, slides); COM via one STA ComWorker"
      ]
    }
  ]
