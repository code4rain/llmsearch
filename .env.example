ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# Atlassian 인증 — 아래 중 하나 (폴백 순서: PAT → USER/PASSWORD → COOKIE)
ATLASSIAN_PAT=
ATLASSIAN_USER=
ATLASSIAN_PASSWORD=
ATLASSIAN_COOKIE=

# 서비스별 자격증명이 다를 때만 설정 — 있으면 공용 ATLASSIAN_*보다 우선 (PAT·쿠키는 서버별 발급)
# PAT 외에 CONFLUENCE_USER/PASSWORD/COOKIE, JIRA_USER/PASSWORD/COOKIE도 동일한 우선순위로 동작한다
CONFLUENCE_PAT=
JIRA_PAT=
